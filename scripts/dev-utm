#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

instance="${MOM_DEV_UTM_INSTANCE:-dev}"
case "${instance}" in
  ""|*[!A-Za-z0-9._-]*)
    echo "MOM_DEV_UTM_INSTANCE must use only letters, numbers, dot, underscore, or dash" >&2
    exit 1
    ;;
esac

if [ "${instance}" = "dev" ]; then
  default_name="AgentMom-Dev"
  default_state_dir="${repo_root}/.state/dev-utm"
  default_log_dir="${repo_root}/.state/logs"
  default_guest_dir="/home/mom/agentmom"
  default_guest_microvm_state_dir="/home/mom/.local/state/agentmom/microvms"
else
  default_name="AgentMom-${instance}"
  default_state_dir="${repo_root}/.state/dev-utm-${instance}"
  default_log_dir="${repo_root}/.state/logs/dev-utm-${instance}"
  default_guest_dir="/home/mom/agentmom-${instance}"
  default_guest_microvm_state_dir="/home/mom/.local/state/agentmom-${instance}/microvms"
fi

name="${MOM_DEV_UTM_NAME:-${default_name}}"
guest_host="${MOM_DEV_UTM_HOST:-agentmom-dev-utm.local}"
guest_user="${MOM_DEV_UTM_USER:-mom}"
guest_dir="${MOM_DEV_UTM_GUEST_DIR:-${default_guest_dir}}"
guest_microvm_state_dir="${MOM_DEV_UTM_MICROVM_STATE_DIR:-${default_guest_microvm_state_dir}}"
guest_microvm_workspace_dir="${MOM_DEV_UTM_MICROVM_WORKSPACE_DIR:-${guest_microvm_state_dir}/workspaces}"
state_dir="${MOM_DEV_UTM_STATE_DIR:-${default_state_dir}}"
log_dir="${MOM_DEV_UTM_LOG_DIR:-${default_log_dir}}"
fallback_key="${state_dir}/id_ed25519"
bundle="${HOME}/Library/Containers/com.utmapp.UTM/Data/Documents/${name}.utm"
data_dir="${bundle}/Data"
disk="${data_dir}/root.img"
kernel_image="${data_dir}/kernel"
initrd_image="${data_dir}/initrd"
auth_pubkey="${AGENTMOM_DEV_UTM_SSH_PUBKEY:-}"
auth_mode="default"

mkdir -p "${state_dir}" "${log_dir}"

if [ "${MOM_DEV_UTM_SHOW_CONFIG:-0}" = "1" ]; then
  cat <<EOF_CONFIG
instance=${instance}
name=${name}
guest_host=${guest_host}
guest_dir=${guest_dir}
guest_microvm_state_dir=${guest_microvm_state_dir}
guest_microvm_workspace_dir=${guest_microvm_workspace_dir}
state_dir=${state_dir}
log_dir=${log_dir}
bundle=${bundle}
EOF_CONFIG
  exit 0
fi

find_port() {
  local port="$1"
  local max_port=$((port + 99))
  while lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; do
    port=$((port + 1))
    if [ "${port}" -gt "${max_port}" ]; then
      echo "No free localhost port found in $1-${max_port}" >&2
      return 1
    fi
  done
  printf '%s\n' "${port}"
}

run_step() {
  local step_name="$1"
  local log_file="$2"
  shift 2

  printf '  %-24s' "${step_name}..."
  if "$@" >"${log_file}" 2>&1; then
    printf 'ok\n'
  else
    printf 'failed\n\n'
    echo "${step_name} failed. Last log lines from ${log_file}:"
    tail -n 100 "${log_file}" || true
    exit 1
  fi
}

ssh_args=()

reset_ssh_args() {
  ssh_args=(
    -o BatchMode=yes
    -o ConnectTimeout=5
    -o ControlMaster=no
    -o ControlPath=none
    -o ExitOnForwardFailure=yes
    -o StrictHostKeyChecking=accept-new
    -o UserKnownHostsFile="${state_dir}/known_hosts"
  )
  if [ "${auth_mode}" = "generated" ]; then
    ssh_args=(-i "${fallback_key}" "${ssh_args[@]}")
  fi
}

ssh_guest() {
  ssh "${ssh_args[@]}" "${guest_user}@${guest_host}" "$@"
}

copy_image() {
  local src="$1"
  local dst="$2"

  rm -f "${dst}"
  if cp -c "${src}" "${dst}" 2>/dev/null; then
    chmod u+w "${dst}"
    return 0
  fi
  if command -v rsync >/dev/null 2>&1 && rsync --sparse --whole-file "${src}" "${dst}"; then
    chmod u+w "${dst}"
    return 0
  fi
  cp "${src}" "${dst}"
  chmod u+w "${dst}"
}

select_ssh_key() {
  local pubkey_file
  if [ -n "${auth_pubkey}" ]; then
    auth_mode="default"
    reset_ssh_args
    return 0
  fi

  for pubkey_file in \
    "${HOME}/.ssh/id_ed25519.pub" \
    "${HOME}/.ssh/id_ecdsa.pub" \
    "${HOME}/.ssh/id_rsa.pub"
  do
    if [ -f "${pubkey_file}" ]; then
      auth_pubkey="$(cat "${pubkey_file}")"
      auth_mode="default"
      reset_ssh_args
      return 0
    fi
  done

  if [ ! -f "${fallback_key}" ]; then
    ssh-keygen -t ed25519 -N "" -f "${fallback_key}" -C "agentmom-dev-utm" >/dev/null
  fi
  auth_pubkey="$(cat "${fallback_key}.pub")"
  auth_mode="generated"
  reset_ssh_args
}

build_image() {
  local image_out toplevel image
  export AGENTMOM_DEV_UTM_SSH_PUBKEY
  AGENTMOM_DEV_UTM_SSH_PUBKEY="${auth_pubkey}"
  image_out="$(nix build --impure --no-link --print-out-paths \
    .#nixosConfigurations.agentmom-dev-utm.config.system.build.image)"
  toplevel="$(nix build --impure --no-link --print-out-paths \
    .#nixosConfigurations.agentmom-dev-utm.config.system.build.toplevel)"
  image="$(find "${image_out}" -type f -name '*.img' -print -quit)"
  if [ -z "${image}" ]; then
    echo "No raw image produced by ${image_out}" >&2
    exit 1
  fi
  printf '%s\n' "${image}"
  printf '%s\n' "${toplevel}"
}

write_bundle() {
  local image="$1"
  local toplevel="$2"
  local uuid drive_id mac boot_params

  if [ -e "${bundle}" ] && [ "${MOM_DEV_UTM_RESET:-0}" != "1" ] && [ "${MOM_DEV_UTM_REBUILD:-0}" != "1" ]; then
    return 0
  fi

  if [ -e "${bundle}" ]; then
    utmctl stop "${name}" >/dev/null 2>&1 || true
    utmctl delete "${name}" >/dev/null 2>&1 || true
    rm -rf "${bundle}"
  fi

  uuid="$(uuidgen)"
  drive_id="$(uuidgen)"
  mac="$(printf '16:%02X:%02X:%02X:%02X:%02X\n' $((RANDOM % 256)) $((RANDOM % 256)) $((RANDOM % 256)) $((RANDOM % 256)) $((RANDOM % 256)))"
  boot_params="$(cat "${toplevel}/kernel-params")"
  mkdir -p "${data_dir}"
  copy_image "${image}" "${disk}"
  cp "${toplevel}/kernel" "${kernel_image}"
  cp "${toplevel}/initrd" "${initrd_image}"

  cat >"${bundle}/config.plist" <<EOF_PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Backend</key>
  <string>Apple</string>
  <key>ConfigurationVersion</key>
  <integer>4</integer>
  <key>Information</key>
  <dict>
    <key>Name</key>
    <string>${name}</string>
    <key>Icon</key>
    <string>linux</string>
    <key>IconCustom</key>
    <false/>
    <key>UUID</key>
    <string>${uuid}</string>
    <key>Notes</key>
    <string>Agent Mom local NixOS dev VM. Generated by just dev-utm.</string>
  </dict>
  <key>System</key>
  <dict>
    <key>Architecture</key>
    <string>aarch64</string>
    <key>CPUCount</key>
    <integer>${MOM_DEV_UTM_CPUS:-6}</integer>
    <key>MemorySize</key>
    <integer>${MOM_DEV_UTM_MEMORY_MIB:-8192}</integer>
    <key>Boot</key>
    <dict>
      <key>OperatingSystem</key>
      <string>Linux</string>
      <key>UEFIBoot</key>
      <false/>
      <key>LinuxKernelPath</key>
      <string>kernel</string>
      <key>LinuxInitialRamdiskPath</key>
      <string>initrd</string>
      <key>LinuxCommandLine</key>
      <string>console=hvc0 ${boot_params} init=${toplevel}/init</string>
    </dict>
    <key>GenericPlatform</key>
    <dict/>
  </dict>
  <key>Virtualization</key>
  <dict>
    <key>Audio</key>
    <false/>
    <key>Balloon</key>
    <false/>
    <key>Entropy</key>
    <true/>
    <key>Keyboard</key>
    <string>Disabled</string>
    <key>Pointer</key>
    <string>Disabled</string>
    <key>ClipboardSharing</key>
    <false/>
  </dict>
  <key>Display</key>
  <array/>
  <key>Drive</key>
  <array>
    <dict>
      <key>ImageName</key>
      <string>root.img</string>
      <key>Identifier</key>
      <string>${drive_id}</string>
      <key>ReadOnly</key>
      <false/>
      <key>Nvme</key>
      <false/>
    </dict>
  </array>
  <key>Network</key>
  <array>
    <dict>
      <key>Mode</key>
      <string>Shared</string>
      <key>MacAddress</key>
      <string>${mac}</string>
    </dict>
  </array>
  <key>Serial</key>
  <array>
    <dict>
      <key>Mode</key>
      <string>Terminal</string>
      <key>Terminal</key>
      <dict>
        <key>BackgroundColor</key>
        <string>#000000</string>
        <key>CursorBlink</key>
        <true/>
        <key>Font</key>
        <string>Menlo</string>
        <key>FontSize</key>
        <integer>12</integer>
        <key>ForegroundColor</key>
        <string>#ffffff</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
EOF_PLIST

  plutil -lint "${bundle}/config.plist" >/dev/null
  open -g "${bundle}"
  for _ in $(seq 1 30); do
    if utmctl status "${name}" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "UTM did not register ${name} after opening ${bundle}" >&2
  return 1
}

start_vm() {
  local status
  status="$(utmctl status "${name}" 2>/dev/null || true)"
  if [ -z "${status}" ]; then
    open -g "${bundle}"
    for _ in $(seq 1 30); do
      status="$(utmctl status "${name}" 2>/dev/null || true)"
      [ -n "${status}" ] && break
      sleep 1
    done
  fi
  if [ "${status}" != "started" ]; then
    utmctl start "${name}" >/dev/null
  fi
}

wait_for_ssh() {
  local ip ssh_log
  ssh_log="${state_dir}/ssh-wait.log"
  printf '  %-24s' "waiting for SSH..."
  for _ in $(seq 1 180); do
    ip="$(utmctl ip-address "${name}" 2>/dev/null | awk '/^[0-9]+\./ { print; exit }' || true)"
    if [ -n "${ip}" ]; then
      guest_host="${ip}"
    fi
    if ssh_guest true >"${ssh_log}" 2>&1; then
      printf 'ok\n'
      return 0
    fi
    if grep -q "Permission denied" "${ssh_log}"; then
      printf 'failed\n\n'
      cat >&2 <<EOF_AUTH
${name} rejected the SSH key used by just dev-utm.

This usually means the VM was created with a different authorized key.
Run a deliberate UTM reset once:

  MOM_DEV_UTM_RESET=1 just dev-utm

EOF_AUTH
      cat "${ssh_log}" >&2 || true
      exit 1
    fi
    sleep 2
  done
  printf 'failed\n\n'
  echo "Could not SSH to ${name}. Last known UTM status:"
  utmctl status "${name}" || true
  echo "Known IPs:"
  utmctl ip-address "${name}" || true
  exit 1
}

sync_tree() {
  if [ ! -f "${repo_root}/.env" ]; then
    echo "Missing ${repo_root}/.env" >&2
    echo "Create it before running just dev-utm." >&2
    return 1
  fi

  ssh_guest "guest_group=\$(id -gn); sudo install -d -m 0755 -o '${guest_user}' -g \"\${guest_group}\" '${guest_dir}' '${guest_dir}/.state'; sudo install -d -m 0750 -o '${guest_user}' -g \"\${guest_group}\" '${guest_dir}/.state/mom' '${guest_microvm_state_dir}' '${guest_microvm_state_dir}/machines' '${guest_microvm_workspace_dir}'"
  rsync -az --delete \
    --exclude .git \
    --exclude .state \
    --exclude target \
    --exclude node_modules \
    --exclude ui/node_modules \
    --exclude worktrees \
    -e "ssh ${ssh_args[*]}" \
    ./ "${guest_user}@${guest_host}:${guest_dir}/"
}

main() {
  local image toplevel api_port worker_port

  select_ssh_key
  if [ ! -e "${disk}" ] || [ "${MOM_DEV_UTM_REBUILD:-0}" = "1" ] || [ "${MOM_DEV_UTM_RESET:-0}" = "1" ]; then
    rm -f "${state_dir}/known_hosts"
    run_step "building guest image" "${log_dir}/dev-utm-build.log" build_image
    image="$(tail -n 2 "${log_dir}/dev-utm-build.log" | head -n 1)"
    toplevel="$(tail -n 1 "${log_dir}/dev-utm-build.log")"
    run_step "writing UTM bundle" "${log_dir}/dev-utm-bundle.log" write_bundle "${image}" "${toplevel}"
  else
    run_step "checking UTM bundle" "${log_dir}/dev-utm-bundle.log" plutil -lint "${bundle}/config.plist"
  fi

  run_step "starting UTM" "${log_dir}/dev-utm-start.log" start_vm
  wait_for_ssh
  run_step "syncing checkout" "${log_dir}/dev-utm-sync.log" sync_tree

  api_port="$(find_port "${MOM_API_PORT:-8787}")"
  worker_port="$(find_port "${MOM_WORKER_PORT:-9090}")"

  cat <<EOF

Agent Mom UTM dev is starting
  Instance: ${instance}
  UI:       http://127.0.0.1:${api_port}
  VM:       ${name} (${guest_user}@${guest_host})
  Guest dir:${guest_dir}
  Logs:     ${log_dir}

Press Ctrl-C to stop the dev process. The UTM VM stays available.
EOF

  exec ssh -tt "${ssh_args[@]}" \
    -L "127.0.0.1:${api_port}:127.0.0.1:${api_port}" \
    -L "127.0.0.1:${worker_port}:127.0.0.1:${worker_port}" \
    "${guest_user}@${guest_host}" \
    "cd '${guest_dir}' && set -a; . ./.env; set +a; MOM_API_PORT='${api_port}' MOM_WORKER_PORT='${worker_port}' MOM_DEV_FIXED_PORTS=1 MOM_MICROVM_STATE_DIR='${guest_microvm_state_dir}' MOM_MICROVM_WORKSPACE_DIR='${guest_microvm_workspace_dir}' MOM_RUNTIME_SUDO=1 nix develop --command bash -lc 'npm --prefix ui ci && just dev'"
}

main "$@"
