#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

pid_file="${repo_root}/.state/dev.pid"
local_state_dir="${repo_root}/.state"

kill_pid() {
  local pid="${1:-}"
  case "${pid}" in
    ''|*[!0-9]*) return 0 ;;
  esac

  kill "${pid}" >/dev/null 2>&1 || true
}

kill_pid_hard() {
  local pid="${1:-}"
  case "${pid}" in
    ''|*[!0-9]*) return 0 ;;
  esac

  kill -KILL "${pid}" >/dev/null 2>&1 || true
}

stop_microvm_units() {
  local machines_dir="${repo_root}/.state/microvms/machines"
  [ -d "${machines_dir}" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  command -v systemd-escape >/dev/null 2>&1 || return 0

  local machine name unit
  for machine in "${machines_dir}"/*; do
    [ -d "${machine}" ] || continue
    name="$(basename "${machine}")"
    unit="$(systemd-escape --template="${MOM_MICROVM_SYSTEMD_TEMPLATE:-agentmom-dev-microvm@.service}" "${name}")"
    sudo -n systemctl stop "${unit}" >/dev/null 2>&1 || systemctl stop "${unit}" >/dev/null 2>&1 || true
  done
}

if [ -f "${pid_file}" ]; then
  # shellcheck disable=SC1090
  source "${pid_file}"
  kill_pid "${worker_pid:-}"
  kill_pid "${api_pid:-}"
  kill_pid "${proxy_pid:-}"
  kill_pid "${sudo_keepalive_pid:-}"
  kill_pid "${dev_run_pid:-}"

  sleep 1
  kill_pid_hard "${worker_pid:-}"
  kill_pid_hard "${api_pid:-}"
  kill_pid_hard "${proxy_pid:-}"
  kill_pid_hard "${sudo_keepalive_pid:-}"
  kill_pid_hard "${dev_run_pid:-}"
fi

stop_microvm_units
rm -rf "${local_state_dir}" "${repo_root}/dev/iron-proxy"

printf 'dev state reset\n'
