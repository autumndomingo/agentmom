#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

find_port() {
  local port="$1"
  local max_port=$((port + 99))
  while lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; do
    port=$((port + 1))
    if [ "${port}" -gt "${max_port}" ]; then
      echo "No free localhost port found in $1-${max_port}" >&2
      return 1
    fi
  done
  printf '%s\n' "${port}"
}

require_free_port() {
  local port="$1"
  if lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "Port ${port} is already in use" >&2
    return 1
  fi
}

api_port="${MOM_API_PORT:-8787}"
worker_port="${MOM_WORKER_PORT:-9090}"
if [ "${MOM_DEV_FIXED_PORTS:-0}" = "1" ]; then
  require_free_port "${api_port}"
  require_free_port "${worker_port}"
else
  api_port="$(find_port "${api_port}")"
  worker_port="$(find_port "${worker_port}")"
fi
microvm_state="${MOM_MICROVM_STATE_DIR:-${repo_root}/.state/microvms}"
microvm_workspaces="${MOM_MICROVM_WORKSPACE_DIR:-${microvm_state}/workspaces}"
microvm_bridge="${MOM_MICROVM_BRIDGE:-agentmom-dev0}"
microvm_cidr="${MOM_MICROVM_CIDR:-192.168.84.0/24}"
microvm_host_ip="${MOM_MICROVM_HOST_IP:-192.168.84.1}"
proxy_bind="${MOM_PROXY_BIND:-${microvm_host_ip}:1080}"
microvm_systemd_template="${MOM_MICROVM_SYSTEMD_TEMPLATE:-agentmom-dev-microvm@.service}"
hermes_agent_url="${MOM_HERMES_AGENT_URL:-}"

mkdir -p .state/mom .state/logs dev/iron-proxy "${microvm_state}/machines" "${microvm_workspaces}"
dev_ca_cert="${repo_root}/dev/iron-proxy/ca.crt"
dev_ca_key="${repo_root}/dev/iron-proxy/ca.key"

if [ ! -s "${dev_ca_cert}" ] || [ ! -s "${dev_ca_key}" ]; then
  tmpdir="$(mktemp -d "${repo_root}/dev/iron-proxy/ca.XXXXXX")"
  trap 'rm -rf "${tmpdir}"' EXIT
  openssl genrsa -out "${tmpdir}/ca.key" 4096 >/dev/null 2>&1
  openssl req -x509 -new -nodes \
    -key "${tmpdir}/ca.key" \
    -sha256 -days 3650 \
    -subj "/CN=agentmom dev iron-proxy CA" \
    -addext "basicConstraints=critical,CA:TRUE" \
    -addext "keyUsage=critical,keyCertSign" \
    -out "${tmpdir}/ca.crt" >/dev/null 2>&1
  install -m 0400 "${tmpdir}/ca.key" "${dev_ca_key}"
  install -m 0444 "${tmpdir}/ca.crt" "${dev_ca_cert}"
  rm -rf "${tmpdir}"
  trap - EXIT
fi

config_file=".state/config.dev.json"
cat >"${config_file}" <<EOF_CONFIG
{
  "schema_version": 1,
  "credentials": {
    "proxy_url": "http://${microvm_host_ip}:1080",
    "proxy_ca_path": "${repo_root}/dev/iron-proxy/ca.crt"
  },
  "guest": {
    "model": "${MOM_DEV_GUEST_MODEL:-openai/gpt-4o-mini}"
  },
  "auth": {
    "secret_file": "${repo_root}/dev/secrets/auth-secret"
  }
}
EOF_CONFIG

env_file=".state/dev.env"
{
  printf 'MOM_CONFIG=%q\n' "${repo_root}/${config_file}"
  printf 'MOM_STATE_DIR=%q\n' "${repo_root}/.state/mom"
  printf 'MOM_MICROVM_STATE_DIR=%q\n' "${microvm_state}"
  printf 'MOM_MICROVM_WORKSPACE_DIR=%q\n' "${microvm_workspaces}"
  printf 'MOM_MICROVM_BRIDGE=%q\n' "${microvm_bridge}"
  printf 'MOM_MICROVM_CIDR=%q\n' "${microvm_cidr}"
  printf 'MOM_MICROVM_HOST_IP=%q\n' "${microvm_host_ip}"
  printf 'MOM_PROXY_BIND=%q\n' "${proxy_bind}"
  printf 'MOM_MICROVM_SYSTEMD_TEMPLATE=%q\n' "${microvm_systemd_template}"
  if [ -n "${hermes_agent_url}" ]; then
    printf 'MOM_HERMES_AGENT_URL=%q\n' "${hermes_agent_url}"
  fi
  printf 'MOM_RUNTIME_SUDO=%q\n' "${MOM_RUNTIME_SUDO:-1}"
  printf 'MOM_WORKER_TOKEN_FILE=%q\n' "${repo_root}/dev/secrets/worker-token"
  printf 'MOM_UI_DIST=%q\n' "${repo_root}/ui/dist"
  printf 'MOM_NODE_ID=%q\n' "dev-node"
  printf 'MOM_LOG_FORMAT=%q\n' "text"
  printf 'MOM_API_BIND=%q\n' "127.0.0.1:${api_port}"
  printf 'MOM_API_URL=%q\n' "http://127.0.0.1:${api_port}"
  printf 'MOM_WORKER_BIND=%q\n' "127.0.0.1:${worker_port}"
  printf 'MOM_WORKER_URL=%q\n' "http://127.0.0.1:${worker_port}"
  printf 'MOM_WORKER_URL_ALLOWLIST=%q\n' "http://127.0.0.1:${worker_port}"
} > "${env_file}"
