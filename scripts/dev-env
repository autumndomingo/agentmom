#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

find_port() {
  local port="$1"
  local max_port=$((port + 99))
  while lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; do
    port=$((port + 1))
    if [ "${port}" -gt "${max_port}" ]; then
      echo "No free localhost port found in $1-${max_port}" >&2
      return 1
    fi
  done
  printf '%s\n' "${port}"
}

api_port="$(find_port "${MOM_API_PORT:-8787}")"
worker_port="$(find_port "${MOM_WORKER_PORT:-9090}")"
repo_hash="$(printf '%s' "${repo_root}" | shasum -a 256 | cut -c1-10)"
msb_home="/tmp/mom-msb-${repo_hash}"

mkdir -p .state/mom .state/logs dev/iron-proxy "${msb_home}"
msb_path="${msb_home}/bin/msb"
dev_ca_cert="${repo_root}/dev/iron-proxy/ca.crt"
dev_ca_key="${repo_root}/dev/iron-proxy/ca.key"

if [ ! -s "${dev_ca_cert}" ] || [ ! -s "${dev_ca_key}" ]; then
  tmpdir="$(mktemp -d "${repo_root}/dev/iron-proxy/ca.XXXXXX")"
  trap 'rm -rf "${tmpdir}"' EXIT
  openssl genrsa -out "${tmpdir}/ca.key" 4096 >/dev/null 2>&1
  openssl req -x509 -new -nodes \
    -key "${tmpdir}/ca.key" \
    -sha256 -days 3650 \
    -subj "/CN=agentmom dev iron-proxy CA" \
    -addext "basicConstraints=critical,CA:TRUE" \
    -addext "keyUsage=critical,keyCertSign" \
    -out "${tmpdir}/ca.crt" >/dev/null 2>&1
  install -m 0400 "${tmpdir}/ca.key" "${dev_ca_key}"
  install -m 0444 "${tmpdir}/ca.crt" "${dev_ca_cert}"
  rm -rf "${tmpdir}"
  trap - EXIT
fi

env_file=".state/dev.env"
{
  printf 'MOM_CONFIG=%q\n' "${repo_root}/config.dev.json"
  printf 'MOM_STATE_DIR=%q\n' "${repo_root}/.state/mom"
  printf 'MSB_HOME=%q\n' "${msb_home}"
  printf 'MSB_PATH=%q\n' "${msb_path}"
  printf 'MOM_WORKER_TOKEN_FILE=%q\n' "${repo_root}/dev/secrets/worker-token"
  printf 'MOM_UI_DIST=%q\n' "${repo_root}/ui/dist"
  printf 'MOM_NODE_ID=%q\n' "dev-node"
  printf 'MOM_LOG_FORMAT=%q\n' "text"
  printf 'MOM_RUNTIME=%q\n' "real"
  printf 'MOM_API_BIND=%q\n' "127.0.0.1:${api_port}"
  printf 'MOM_API_URL=%q\n' "http://127.0.0.1:${api_port}"
  printf 'MOM_WORKER_BIND=%q\n' "127.0.0.1:${worker_port}"
  printf 'MOM_WORKER_URL=%q\n' "http://127.0.0.1:${worker_port}"
  printf 'MOM_WORKER_URL_ALLOWLIST=%q\n' "http://127.0.0.1:${worker_port}"
} > "${env_file}"
