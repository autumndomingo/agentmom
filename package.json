{
  "name": "agentmom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production tsx src/server.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts && tsx scripts/smoke-workspace-catalog.ts && tsx scripts/smoke-telegram-catalog.ts",
    "smoke:cli": "tsx scripts/smoke-mom-cli.ts",
    "smoke:web-search": "tsx scripts/smoke-web-search.ts",
    "smoke:session-switch": "tsx scripts/smoke-session-switch.ts",
    "smoke:skills": "AGENTMOM_EXECUTOR=local tsx scripts/smoke-skills.ts",
    "smoke:fly": "tsx scripts/smoke-fly.ts",
    "smoke:local": "AGENTMOM_EXECUTOR=local tsx scripts/smoke-local.ts",
    "smoke:deploy": "AGENTMOM_EXECUTOR=local tsx scripts/smoke-deploy.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.12.19",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^5.1.2",
    "grammy": "^1.43.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  },
  "overrides": {
    "@assistant-ui/core": "0.1.7",
    "@assistant-ui/store": "0.2.3",
    "@assistant-ui/tap": "0.5.3"
  }
}
