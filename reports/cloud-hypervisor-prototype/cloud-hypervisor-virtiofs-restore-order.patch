+
+    pub fn take_pending_backend_restore(&mut self) -> Result<Option<PendingBackendRestore>> {
+        match (self.vring_bases.take(), self.backend_state.take()) {
+            (Some(vring_bases), Some(backend_state)) => {
+                Ok(Some(PendingBackendRestore::new(vring_bases, backend_state)))
+            }
+            (None, None) => Ok(None),
+            _ => Err(Error::InconsistentBackendState),
+        }
+    }
+}
+
+pub struct PendingBackendRestore {
+    vring_bases: Vec<u64>,
+    backend_state: Option<Vec<u8>>,
+}
+
+impl PendingBackendRestore {
+    fn new(vring_bases: Vec<u64>, backend_state: Vec<u8>) -> Self {
+        Self {
+            vring_bases,
+            backend_state: Some(backend_state),
+        }
+    }
+
+    pub fn vring_bases(&self) -> &[u64] {
+        &self.vring_bases
+    }
+
+    pub fn consume_backend_state(&mut self) -> Result<Vec<u8>> {
+        self.backend_state
+            .take()
+            .ok_or(Error::BackendRestoreAlreadyConsumed)
+    }
+
+    pub fn is_consumed(&self) -> bool {
+        self.backend_state.is_none()
+    }
 }
 
